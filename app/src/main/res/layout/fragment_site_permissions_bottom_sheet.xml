<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 bottom sheet that lets the user review and flip every
    permission for the current origin. Opened from
    `ConnectionInfoBottomSheet` via a tappable "Site permissions" pill.

    Rows are declared statically here (one per permission type exposed
    by `mozilla.components.concept.engine.permission.SitePermissions`),
    hidden by default and shown programmatically only when the storage
    has a non-NO_DECISION value for that permission - matching the
    "icons of enabled permissions" visual the user asked for. The user
    can still flip any switch; flipping an initially-hidden row only
    happens if the user explicitly surfaces that permission via a
    future "show all permissions" affordance (not implemented in this
    first cut; current UX shows only the permissions the site actually
    requested at least once).

    All switches are `com.google.android.material.materialswitch.MaterialSwitch`
    to match the settings-screen style.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/site_permissions_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/origin_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="middle"
            android:maxLines="1"
            tools:text="https://example.com" />

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/site_permissions_empty_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/permissions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <!-- Rows injected dynamically from Kotlin so we don't have to repeat
                 12 near-identical blocks of XML. Each row is a horizontal
                 LinearLayout: icon + label-stack + MaterialSwitch. See
                 SitePermissionsBottomSheet.addPermissionRow(...). -->
        </LinearLayout>

        <!--
            Cookie Policy row: a plain label on the left, a tappable
            status pill on the right that both displays the current
            retention window and opens the chooser dialog when tapped.
            Replaces the previous outlined-button + subtitle pair; the
            pill now carries the status text itself so no separate
            subtitle is needed.

            See SitePermissionsBottomSheet.refreshCookieRetentionPill
            for how the pill text is kept in sync with
            CookiePolicyRepository.
        -->
        <LinearLayout
            android:id="@+id/cookie_policy_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cookie_policy_label"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <!--
                Material 3 Assist Chip. Corner radius comes from the
                M3 chip shape (8 dp small-component) which is far less
                rounded than the previous button-with-cornerRadius=18dp
                look, matching the rest of the app's chip surfaces.
                The chip is non-checkable (plain tap-to-open) and the
                `app:chipIcon` slot is used for the current status's
                history glyph.
            -->
            <com.google.android.material.chip.Chip
                android:id="@+id/cookie_retention_pill"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:chipIcon="@drawable/ic_baseline_history"
                app:chipIconVisible="true"
                tools:text="Never" />

        </LinearLayout>

        <!--
            Clear cookies / site-data. Moved here from the Connection Info
            sheet (post-v0.5.14) so destructive site-scoped actions live
            next to the per-permission toggles the user is already
            inspecting. Guarded by a confirmation dialog.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_cookies_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clear_cookies_and_site_data"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:icon="@drawable/ic_baseline_lock_open"
            app:iconGravity="start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/close"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>

</ScrollView>
