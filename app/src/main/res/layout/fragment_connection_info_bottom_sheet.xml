<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Security Icon and Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/security_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/security_icon"
            android:src="@drawable/ic_baseline_lock"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/security_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/connection_is_secure"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>

    <!-- Website Title -->
    <TextView
        android:id="@+id/website_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/website_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Website URL -->
    <TextView
        android:id="@+id/website_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/example_url"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="20dp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <!-- Certificate Info Section -->
    <LinearLayout
        android:id="@+id/certificate_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/certificate_information"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Issuer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/issued_by"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/certificate_issuer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/certificate_authority"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

        <!-- Certificate Holder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/issued_to"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/certificate_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/example_domain"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Privacy Section -->
    <LinearLayout
        android:id="@+id/privacy_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_and_security"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Tracking Protection Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enhanced_tracking_protection"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tracking_protection_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blocks_trackers"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <!--
                Material 3 switch. Previously `SwitchMaterial` (M2 pill),
                which bypassed the global `switchStyle` theme override and
                visually diverged from the M3 `MaterialSwitch` used across
                the settings screens. Nira now uses `MaterialSwitch` here
                for consistency with the Preferences UI.
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/tracking_protection_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!--
            Tappable "Site permissions" pill. Shows a label plus up to
            five icons representing permissions that are currently in a
            non-default state. Tapping opens `SitePermissionsBottomSheet`.
            Hidden when the current origin has no stored permissions.

            The pill mimics a Material 3 outlined chip but keeps the
            same button widget family as the other actions so the touch
            feedback stays consistent.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/site_permissions_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/site_permissions"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!--
                    Up to five icon slots. Filled from Kotlin based on the
                    stored SitePermissions row; empty slots stay GONE.
                -->
                <LinearLayout
                    android:id="@+id/site_permissions_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mozac_ic_chevron_right_20"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            Clear cookies has moved into the Site Permissions bottom sheet
            (reachable via the pill above). Keeping only the pill here
            avoids duplicating a destructive action across two surfaces.
        -->

    </LinearLayout>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
