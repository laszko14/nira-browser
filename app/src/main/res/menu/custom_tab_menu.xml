    custom-tab menu is now rendered via Material3BrowserMenu (see
    ExternalAppBrowserFragment.showCustomTabMenu) which builds its item
    list in Kotlin, so this file is unused at runtime. Kept so the
    menuInflater call-site in older cherry-picks still resolves.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/menu_find_in_page"
        android:title="@string/browser_menu_find_in_page"
        android:icon="@drawable/ic_baseline_find_in_page" />

    <item
        android:id="@+id/menu_share"
        android:title="@string/share"
        android:icon="@drawable/ios_share_24" />

    <item
        android:id="@+id/menu_open_in_browser"
        android:title="@string/browser_menu_open_in_nira" />

</menu>
