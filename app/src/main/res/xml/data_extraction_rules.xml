<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep browser history, cookies, sessions and profile data out of backups. -->
    <cloud-backup>
        <include domain="sharedpref" path="scw_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="scw_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
