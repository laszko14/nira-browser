{
  "manifest_version": 2,
  "name": "Zavro Video Search Bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "zavro-video-search@prirai.android.nira"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ]
}
