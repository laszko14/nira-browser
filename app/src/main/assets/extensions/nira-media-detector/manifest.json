{
  "manifest_version": 2,
  "name": "Nira Media Detector",
  "version": "1.2.1",
  "browser_specific_settings": {
    "gecko": { "id": "nira-media-detector@prirai.android.nira" }
  },
  "permissions": [
    "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons",
    "webRequest", "http://*/*", "https://*/*"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js", "full-titles.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
